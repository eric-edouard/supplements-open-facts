{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": [
		"created",
		"contributor",
		"paper",
		"effect",
		"study_role",
		"direction",
		"strength"
	],
	"properties": {
		"created": { "type": "string" },
		"contributor": { "type": "string" },
		"paper": { "type": "string" },
		"effect": { "type": "string" },
		"study_role": { "enum": ["primary-outcome", "secondary-outcome", "adverse-event"] },
		"direction": { "enum": ["increase", "decrease", "no-change"] },
		"description": { "type": "string" },
		"strength": { "enum": ["strong", "moderate", "weak", "none"] },
		"p_value": { "type": ["number", "string"] },
		"effect_size": { "type": "string" },
		"dosage": {
			"type": "object",
			"properties": {
				"value": { "type": "number" },
				"min": { "type": "number" },
				"max": { "type": "number" },
				"unit": { 
					"type": "string",
					"enum": ["microgram", "milligram", "gram", "kilogram", "IU", "mg/kg", "g/kg"]
				}
			},
			"required": ["unit"],
			"anyOf": [
				{ "required": ["value"] },
				{ "required": ["min", "max"] },
				{ "required": ["value", "min", "max"] }
			]
		},
		"onset_duration": {
			"type": "object",
			"properties": {
				"value": { "type": "number" },
				"min": { "type": "number" },
				"max": { "type": "number" },
				"unit": { 
					"type": "string",
					"enum": ["immediate", "minutes", "hours", "days", "weeks", "months", "years"]
				}
			},
			"required": ["unit"],
			"anyOf": [
				{ "required": ["value"] },
				{ "required": ["min", "max"] },
				{ "required": ["value", "min", "max"] }
			]
		},
		"timing": { 
			"type": "string",
			"enum": ["upon-waking", "morning", "afternoon", "evening", "bedtime", "pre-meal", "with-meal", "post-meal", "between-meals", "empty-stomach", "pre-exercise", "intra-exercise", "post-exercise"]
		},
		"groundings": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["fields", "quote", "source"],
				"properties": {
					"fields": {
						"type": "array",
						"items": { "type": "string" },
						"minItems": 1
					},
					"quote": { "type": "string" },
					"source": { "enum": ["abstract", "paper_content"] },
					"char_start": { "type": "integer", "minimum": 0 },
					"char_end": { "type": "integer", "minimum": 0 },
					"alignment": { "enum": ["exact", "fuzzy"] }
				},
				"additionalProperties": false
			}
		}
	}
}
