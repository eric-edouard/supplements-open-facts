{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["created", "contributor", "paper", "threshold_amount"],
	"properties": {
		"created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"contributor": { "type": "string" },
		"paper": { "type": "string" },
		"threshold_amount": { "type": "number" },
		"change": {
			"enum": [
				"negative",
				"slightly-negative",
				"neutral",
				"slightly-positive",
				"positive"
			]
		},
		"change_percent": { "type": "number" },
		"effect": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
		"population": {
			"type": "string",
			"enum": ["adults", "elderly", "children", "adolescents", "pregnant", "lactating", "all"]
		},
		"paper_quotes": {
			"type": "object",
			"properties": {
				"abstract": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"paper_content": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		}
	}
}
