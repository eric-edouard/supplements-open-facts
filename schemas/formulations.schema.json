{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["created", "contributor", "paper", "formulation"],
	"properties": {
		"created": { "type": "string" },
		"contributor": { "type": "string" },
		"paper": { "type": "string" },
		"formulation": { "type": "string" },
		"change": {
			"enum": [
				"negative",
				"slightly-negative",
				"neutral",
				"slightly-positive",
				"positive"
			]
		},
		"change_percent": { "type": "number" },
		"groundings": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["fields", "quote", "source"],
				"properties": {
					"fields": {
						"type": "array",
						"items": { "type": "string" },
						"minItems": 1
					},
					"quote": { "type": "string" },
					"source": { "enum": ["abstract", "paper_content"] },
					"char_start": { "type": "integer", "minimum": 0 },
					"char_end": { "type": "integer", "minimum": 0 },
					"alignment": { "enum": ["exact", "fuzzy"] }
				},
				"additionalProperties": false
			}
		}
	},
	"anyOf": [{ "required": ["change"] }, { "required": ["change_percent"] }]
}
