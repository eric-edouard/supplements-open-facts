{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["created", "contributor", "paper", "cycle"],
	"properties": {
		"created": { "type": "string" },
		"contributor": { "type": "string" },
		"paper": { "type": "string" },
		"cycle": { "enum": ["none", "suggested", "recommended"] },
		"days_on_off": { "type": "string" },
		"weeks_on_off": { "type": "string" },
		"months_on_off": { "type": "string" },
		"groundings": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["fields", "quote", "source"],
				"properties": {
					"fields": {
						"type": "array",
						"items": { "type": "string" },
						"minItems": 1
					},
					"quote": { "type": "string" },
					"source": { "enum": ["abstract", "paper_content"] },
					"char_start": { "type": "integer", "minimum": 0 },
					"char_end": { "type": "integer", "minimum": 0 },
					"alignment": { "enum": ["exact", "fuzzy"] }
				},
				"additionalProperties": false
			}
		}
	}
}
